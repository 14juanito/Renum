# Secret de signature des sessions (>= 32 caractères aléatoires) — OBLIGATOIRE en production
SESSION_SECRET=
# Compte administrateur initial (créé au premier démarrage)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Persistance : PostgreSQL (prioritaire) ou Vercel Blob (privé)
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Charger un jeu de données de démonstration (1 = oui)
SEED_DEMO=1
# IA (optionnel) — sans clé, classifieur local par mots-clés
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# E-mail transactionnel (optionnel, Resend). Sans clé : mode démo, codes affichés à l'écran
RESEND_API_KEY=
EMAIL_FROM=
# URL publique (QR code, liens e-mail)
NEXT_PUBLIC_APP_URL=
